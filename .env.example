CZ_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=text

# Kafka (host view; containers override the host)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CLIENT_ID=cryptozilla

INGEST_TRADES_TOPIC=trades.raw

BINANCE_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_INSTRUMENTS=BTC-USDT,ETH-USDT,SOL-USDT,XRP-USDT,DOGE-USDT

# Object storage. Local-only credentials, never reuse them anywhere real.
MINIO_ROOT_USER=cz-admin
MINIO_ROOT_PASSWORD=local-admin-secret
WAREHOUSE_BUCKET=warehouse
CATALOG_S3_ACCESS_KEY=cz-catalog
CATALOG_S3_SECRET_KEY=local-catalog-secret

# Catalog
POSTGRES_PASSWORD=local-postgres-secret
LAKEKEEPER_ENCRYPTION_KEY=local-only-change-me-for-anything-real
CATALOG_NAME=lake
CATALOG_URI=http://localhost:8181/catalog
CATALOG_WAREHOUSE=cz

# Spark
SPARK_CHECKPOINT_ROOT=file:///tmp/cz-checkpoints
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
